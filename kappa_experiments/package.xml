<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>kappa_experiments</name>
  <version>0.1.0</version>
  <description>Predefined corridor scenarios for standalone real-robot tests of the kappa analytical planner (unicycle).</description>
  <maintainer email="alex_gg97@hotmail.com">alex</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf_transformations</depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>box_sim</exec_depend>
  <!-- rosbot_interface + mpc_test_node, started by the launch files -->
  <exec_depend>demo_mpc</exec_depend>
  <!-- metrics layer: postprocess reads rosbag2 and draws the run figures -->
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
